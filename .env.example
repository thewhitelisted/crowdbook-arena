# Copy to .env and fill in. Never commit .env.

# The domain the arena is served on; its DNS A (and AAAA) record points at this server.
ARENA_DOMAIN=arena.example.com

# SQLite on the data volume unless changed. For Postgres, start with --profile postgres and use:
# ARENA_DATABASE_URL=postgresql+psycopg://arena:change-me@postgres/arena
# POSTGRES_PASSWORD=change-me

# Optional limits; README.md lists every setting.
# ARENA_MAX_PLAYERS=32
# ARENA_MARKET_KINDS=calm,news,trending
